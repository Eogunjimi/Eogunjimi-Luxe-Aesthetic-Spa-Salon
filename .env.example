# Copy this to .env.local and fill in the real values for production.
# Vite exposes only vars prefixed with VITE_ to the browser bundle.

# Your canonical production domain (no trailing slash).
# Used for canonical URLs, og:url, schema @id, and sitemap generation.
VITE_SITE_URL=https://yourdomain.com

# (Optional) Google Analytics 4 measurement ID.
# VITE_GA4_ID=G-XXXXXXXXXX

# (Optional) Google Search Console verification meta content.
# VITE_GSC_VERIFICATION=
